PEER_NAME=pokoinpos-peer2
POKOINPOS_LISTEN_PORT=43001
POKOINPOS_ADVERTISE_HOST=replace-with-your-public-ip-or-dns
POKOINPOS_OPS_PORT=8081
# Comma-separated bootstrap seed nodes. Include every stable Oracle seed node.
POKOINPOS_BOOTSTRAP_PEERS=92.5.153.117:43000,130.162.242.213:43001
# Dynamic manifest is tried first; static bootstrap peers remain local fallback.
POKOINPOS_BOOTSTRAP_MANIFEST_URL=https://pokoin.com/bootstrap-peers.json
POKOINPOS_BOOTSTRAP_REFRESH_INTERVAL_HOURS=24
# Legacy single-seed fallback kept for older deployments.
POKOINPOS_JOIN_HOST=92.5.153.117
POKOINPOS_JOIN_PORT=43000
# Optional. Set only if you want guarded operator actions such as manual mine,
# mint, or validator reward withdraw from the local dashboard/API.
POKOINPOS_OPERATOR_TOKEN=
# Optional monthly validator rewards payout wallet. Leave empty to disable.
POKOINPOS_REWARD_PAYOUT_ADDRESS=
POKOINPOS_SLOT_SECONDS=1
POKOINPOS_IDLE_SLOT_INTERVAL=30
POKOINPOS_BASE_MINE_ATTEMPTS_PER_TICK=1
POKOINPOS_MAX_MINE_ATTEMPTS_PER_TICK=100
POKOINPOS_MINE_ATTEMPTS_PER_PENDING_TX=100
POKOINPOS_GENESIS_HARDNESS=10000
POKOINPOS_GENESIS_SEED=42
POKOINPOS_INITIAL_BALANCE=1000000
POKOINPOS_FINALITY_DEPTH=1
POKOINPOS_EVM_CHAIN_ID=26062026
POKOINPOS_EVM_NETWORK_ID=26062026
# Optional comma-separated EVM wallet funding at genesis:
# POKOINPOS_EVM_GENESIS_ALLOC=0xabc...:1000000,0xdef...:500000
POKOINPOS_STATE_HOST_PATH=./.pokoinpos-peer2-state
POKOINPOS_STATE_SAVE_INTERVAL_SECONDS=15
POKOINPOS_RECONNECT_INTERVAL_SECONDS=5
POKOINPOS_AUTO_UPDATE=true
POKOINPOS_UPDATE_INTERVAL_SECONDS=60

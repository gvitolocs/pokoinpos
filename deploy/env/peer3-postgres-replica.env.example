MARKETPLACE_DB_CONTAINER_NAME=pokoin-marketplace-postgres-replica
MARKETPLACE_DB_NAME=pokoin_marketplace
MARKETPLACE_DB_USER=pokoin_marketplace
MARKETPLACE_DB_PASSWORD=change-me-same-app-password-as-primary
MARKETPLACE_DB_PUBLIC_HOST=peer3-public-host-or-ip
MARKETPLACE_DB_PORT=5432
MARKETPLACE_DB_BIND_HOST=0.0.0.0
MARKETPLACE_DB_MAX_CONNECTIONS=80
MARKETPLACE_DB_STATEMENT_TIMEOUT=15000
MARKETPLACE_DB_IDLE_TX_TIMEOUT=15000
MARKETPLACE_DB_MAX_WAL_SENDERS=10
MARKETPLACE_DB_MAX_REPLICATION_SLOTS=10
MARKETPLACE_DB_WAL_KEEP_SIZE=2048MB
MARKETPLACE_DB_DATA_HOST_PATH=/var/lib/pokoinpos-postgres-replica
MARKETPLACE_DB_CERTS_HOST_PATH=/etc/pokoinpos-postgres/certs
MARKETPLACE_DB_BACKUP_HOST_PATH=/var/backups/pokoinpos-postgres

# Primary peer4 connection used by postgres-replica-bootstrap.sh.
MARKETPLACE_DB_PRIMARY_HOST=peer4-public-host-or-ip
MARKETPLACE_DB_PRIMARY_PORT=5432
MARKETPLACE_DB_REPLICATION_USER=pokoin_replicator
MARKETPLACE_DB_REPLICATION_PASSWORD=change-me-same-replication-password-as-primary
MARKETPLACE_DB_REPLICATION_SLOT=pokoin_peer3_replica

# Restrict application access to trusted API/Vercel egress CIDRs. Replication
# traffic is inbound to peer3 only after failover/rebuild, so keep this tight.
MARKETPLACE_DB_ALLOWED_CIDRS=

# Vercel/API failover connection string format:
# MARKETPLACE_DATABASE_URL=postgresql://pokoin_marketplace:password@peer3-host:5432/pokoin_marketplace?sslmode=require

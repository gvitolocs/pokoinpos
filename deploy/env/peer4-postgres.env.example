MARKETPLACE_DB_CONTAINER_NAME=pokoin-marketplace-postgres
MARKETPLACE_DB_NAME=pokoin_marketplace
MARKETPLACE_DB_USER=pokoin_marketplace
MARKETPLACE_DB_PASSWORD=change-me-long-random-password
MARKETPLACE_DB_PUBLIC_HOST=peer4-public-host-or-ip
MARKETPLACE_DB_PORT=5432
MARKETPLACE_DB_BIND_HOST=0.0.0.0
MARKETPLACE_DB_MAX_CONNECTIONS=80
MARKETPLACE_DB_STATEMENT_TIMEOUT=15000
MARKETPLACE_DB_IDLE_TX_TIMEOUT=15000
MARKETPLACE_DB_MAX_WAL_SENDERS=10
MARKETPLACE_DB_MAX_REPLICATION_SLOTS=10
MARKETPLACE_DB_WAL_KEEP_SIZE=2048MB
MARKETPLACE_DB_DATA_HOST_PATH=/var/lib/pokoinpos-postgres
MARKETPLACE_DB_CERTS_HOST_PATH=/etc/pokoinpos-postgres/certs
MARKETPLACE_DB_BACKUP_HOST_PATH=/var/backups/pokoinpos-postgres

MARKETPLACE_DB_REPLICATION_USER=pokoin_replicator
MARKETPLACE_DB_REPLICATION_PASSWORD=change-me-long-random-replication-password

# Peer CIDRs allowed to connect for replication. Keep this limited to the
# peer3 public IP/CIDR, for example: 141.147.62.244/32
MARKETPLACE_DB_REPLICA_CIDRS=

# Comma-separated CIDR list for firewall helper, for example:
# MARKETPLACE_DB_ALLOWED_CIDRS=203.0.113.10/32,198.51.100.0/24
MARKETPLACE_DB_ALLOWED_CIDRS=

# Vercel/API connection string format:
# MARKETPLACE_DATABASE_URL=postgresql://pokoin_marketplace:password@peer4-host:5432/pokoin_marketplace?sslmode=require

